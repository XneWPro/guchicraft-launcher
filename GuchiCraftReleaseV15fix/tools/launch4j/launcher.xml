<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
    <dontWrapJar>true</dontWrapJar>
    <headerType>gui</headerType>

    <outfile>GuchicraftLauncher.exe</outfile>

    <jar></jar>

    <classPath>
        <mainClass>ru.ezcraft.launcher.LauncherBootstrap</mainClass>
        <cp>app/*</cp>
    </classPath>

    <jre>
        <path>runtime</path>
        <requiresJdk>false</requiresJdk>
        <requires64Bit>true</requires64Bit>

        <opts>
            <opt>--module-path</opt>
            <opt>javafx</opt>
            <opt>--add-modules</opt>
            <opt>javafx.controls</opt>
            <opt>-Dfile.encoding=UTF-8</opt>
            <opt>-Dguchicraft.launcher.version=1.0.9</opt>
            <opt>-Dguchicraft.launcher.root=.</opt>
            <opt>-Dguchicraft.updater.jar=updater/guchicraft-updater.jar</opt>
        </opts>
    </jre>

    <versionInfo>
        <fileVersion>1.0.9.0</fileVersion>
        <txtFileVersion>1.0.9</txtFileVersion>
        <fileDescription>GUCHICRAFT Launcher</fileDescription>
        <copyright>GUCHICRAFT</copyright>
        <productVersion>1.0.9.0</productVersion>
        <txtProductVersion>1.0.9</txtProductVersion>
        <productName>GUCHICRAFT Launcher</productName>
        <internalName>GuchicraftLauncher</internalName>
        <originalFilename>GuchicraftLauncher.exe</originalFilename>
    </versionInfo>
</launch4jConfig>